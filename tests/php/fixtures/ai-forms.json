 {
  "prompt": "NPS survey with follow-up for low scores",
  "ai": {
   "title": "How did we do?",
   "confirmation_message": "Thank you for your feedback.",
   "steps": [
    {
     "title": "",
     "fields": [
      {
       "key": "nps",
       "type": "nps",
       "label": "How likely are you to recommend us?",
       "required": true
      },
      {
       "key": "why_low",
       "type": "textarea",
       "label": "What went wrong?",
       "required": false,
       "logic": {
        "action": "show",
        "match": "all",
        "rules": [
         {
          "field": "nps",
          "op": "lte",
          "value": "6"
         }
        ]
       }
      },
      {
       "key": "why_high",
       "type": "textarea",
       "label": "What did you love?",
       "required": false,
       "logic": {
        "action": "show",
        "match": "all",
        "rules": [
         {
          "field": "nps",
          "op": "gte",
          "value": "9"
         }
        ]
       }
      },
      {
       "key": "email",
       "type": "email",
       "label": "Email (optional)",
       "required": false
      }
     ]
    }
   ]
  },
  "max_fixes": 0
 },
 {
  "prompt": "Website quote with ecommerce question only for shops",
  "ai": {
   "title": "Website quote",
   "confirmation_message": "We'll send your quote within 2 days.",
   "steps": [
    {
     "title": "Project",
     "fields": [
      {
       "key": "type",
       "type": "radio",
       "label": "Type of site",
       "required": true,
       "options": [
        "Business site",
        "Online shop",
        "Blog"
       ]
      },
      {
       "key": "products",
       "type": "number",
       "label": "How many products?",
       "required": false,
       "logic": {
        "action": "show",
        "match": "all",
        "rules": [
         {
          "field": "type",
          "op": "is",
          "value": "Online shop"
         }
        ]
       }
      },
      {
       "key": "pages",
       "type": "number",
       "label": "Number of pages",
       "required": false
      }
     ]
    },
    {
     "title": "Contact",
     "fields": [
      {
       "key": "email",
       "type": "email",
       "label": "Email",
       "required": true
      },
      {
       "key": "budget",
       "type": "select",
       "label": "Budget",
       "required": true,
       "options": [
        "<$2k",
        "$2-5k",
        "$5k+"
       ]
      }
     ]
    }
   ]
  },
  "max_fixes": 0
 },
 {
  "prompt": "Price calculator for painting a room",
  "ai": {
   "title": "Painting estimate",
   "confirmation_message": "Here is your estimate.",
   "steps": [
    {
     "title": "",
     "fields": [
      {
       "key": "area",
       "type": "number",
       "label": "Wall area (m2)",
       "required": true,
       "min": 1
      },
      {
       "key": "coats",
       "type": "select",
       "label": "Coats",
       "required": true,
       "options": [
        "1",
        "2",
        "3"
       ]
      },
      {
       "key": "estimate",
       "type": "calculation",
       "label": "Estimate",
       "required": false,
       "formula": "{area} * {coats} * 4.5"
      },
      {
       "key": "email",
       "type": "email",
       "label": "Email",
       "required": true
      }
     ]
    }
   ]
  },
  "max_fixes": 0
 },
