[
 {
  "prompt": "A contact form for a dental clinic",
  "ai": {
   "title": "Contact the clinic",
   "confirmation_message": "Thanks, we will call you back.",
   "steps": [
    {
     "title": "",
     "fields": [
      {
       "key": "name",
       "type": "name",
       "label": "Full name",
       "required": true
      },
      {
       "key": "email",
       "type": "email",
       "label": "Email",
       "required": true,
       "width": "half"
      },
      {
       "key": "phone",
       "type": "phone",
       "label": "Phone",
       "required": false,
       "width": "half"
      },
      {
       "key": "reason",
       "type": "select",
       "label": "Reason for visit",
       "required": true,
       "options": [
        "Check-up",
        "Pain",
        "Cleaning",
        "Other"
       ]
      },
      {
       "key": "reason_other",
       "type": "text",
       "label": "Please describe",
       "required": true,
       "logic": {
        "action": "show",
        "match": "all",
        "rules": [
         {
          "field": "reason",
          "op": "is",
          "value": "Other"
         }
        ]
       }
      },
      {
       "key": "message",
       "type": "textarea",
       "label": "Message",
       "required": false
      },
      {
       "key": "consent",
       "type": "consent",
       "label": "Privacy",
       "required": true,
       "content": "I agree to be contacted."
      }
     ]
    }
   ]
  },
  "max_fixes": 0
 },
 {
  "prompt": "3-step wedding photography inquiry with package prices",
  "ai": {
   "title": "Wedding inquiry",
   "confirmation_message": "Congratulations! We'll be in touch.",
   "steps": [
    {
     "title": "The day",
     "fields": [
      {
       "key": "date",
       "type": "date",
       "label": "Wedding date",
       "required": true
      },
      {
       "key": "venue",
       "type": "text",
       "label": "Venue",
       "required": true
      },
      {
       "key": "guests",
       "type": "number",
       "label": "Guests",
       "required": false,
       "min": 1
      }
     ]
    },
    {
     "title": "Package",
     "fields": [
      {
       "key": "package",
       "type": "product",
       "label": "Package",
       "required": true,
       "options": [
        "Essential",
        "Full day",
        "Destination"
       ],
       "option_prices": [
        1200,
        2400,
        3900
       ]
      },
      {
       "key": "extras",
       "type": "checkbox",
       "label": "Extras",
       "required": false,
       "options": [
        "Album",
        "Second shooter",
        "Drone"
       ]
      },
      {
       "key": "total",
       "type": "total",
       "label": "Estimated total",
       "required": false
      }
     ]
    },
    {
     "title": "You",
     "fields": [
      {
       "key": "name",
       "type": "name",
       "label": "Names",
       "required": true
      },
      {
       "key": "email",
       "type": "email",
       "label": "Email",
       "required": true
      }
     ]
    }
   ]
  },
  "max_fixes": 0
 },
 {
  "prompt": "Job application for a barista with CV upload",
